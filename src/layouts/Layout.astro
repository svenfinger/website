---
import "../styles/global.css";
import { SiteHeader } from "@/components/site-header";
import SiteFooter from "@/components/site-footer.astro";
import WorkNav from "@/components/work-nav.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  workNav,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = Astro.site ? new URL("/og.png", Astro.site) : undefined;
---

<html lang="en" class="semantic-tokens antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="flex min-h-svh flex-col">
      <SiteHeader
        client:load
        currentPath={Astro.url.pathname}
        sticky={!workNav}
      />
      {
        workNav && (
          <WorkNav
            title={workNav.title}
            prevHref={workNav.prevHref}
            nextHref={workNav.nextHref}
          />
        )
      }
      <div class="flex w-full min-w-0 flex-1 flex-col overflow-x-clip">
        <main class="page-shell flex flex-1 flex-col">
          <slot>
            <h1
              class="text-3xl leading-(--leading-title) font-(--font-weight-title) tracking-(--tracking-title)"
            >
              {title}
            </h1>
          </slot>
        </main>
        <SiteFooter />
      </div>
    </div>
    <script>
      import { init } from "@plausible-analytics/tracker";
      import { SITE_HOST } from "../lib/site";

      init({ domain: SITE_HOST });
    </script>
  </body>
</html>
