---
import "../styles/global.css";
import fontUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import SiteHeader from "@/components/site-header.astro";
import SiteFooter from "@/components/site-footer.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

const {
  title,
  description = SITE_DESCRIPTION,
  socialImage = "/og.png",
  noindex = false,
  home = false,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = Astro.site ? new URL(socialImage, Astro.site) : undefined;
---

<html lang="en" class="semantic-tokens antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell site-layout">
      {!home && <SiteHeader />}
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter showContact={home} />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    translate: 0 calc(-100% - var(--space-8));
  }

  .skip-link:focus {
    translate: 0;
  }
</style>
