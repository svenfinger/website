---
import "../styles/global.css";
import { AppShell } from "@/components/app-shell";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <AppShell client:load currentPath={Astro.url.pathname} title={title} />
  </body>
</html>
