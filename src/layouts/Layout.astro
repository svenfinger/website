---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import fontUrl from "@fontsource-variable/google-sans-flex/files/google-sans-flex-latin-wght-normal.woff2?url";
import { SiteHeader } from "@/components/site-header";
import SiteFooter from "@/components/site-footer.astro";
import WorkNav from "@/components/work-nav.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";
import { pageTransition, workTransition } from "../lib/transitions";

const {
  title,
  description = SITE_DESCRIPTION,
  socialImage = "/og.png",
  noindex = false,
  workNav,
  fullWidth = false,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = Astro.site ? new URL(socialImage, Astro.site) : undefined;
---

<html
  lang="en"
  class="semantic-tokens antialiased"
  data-page-entry="initial"
  transition:name="root"
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="flex min-h-svh flex-col">
      <SiteHeader
        client:load
        transition:persist="site-header"
        currentPath={Astro.url.pathname}
        sticky={!workNav}
      />
      {
        workNav && (
          <WorkNav
            title={workNav.title}
            prevHref={workNav.prevHref}
            nextHref={workNav.nextHref}
          />
        )
      }
      <div
        class="flex w-full min-w-0 flex-1 flex-col overflow-x-clip"
        data-page-content
        transition:name={workNav ? "work-content" : "page-content"}
        transition:animate={workNav ? workTransition : pageTransition}
      >
        <main
          class:list={[
            "flex min-w-0 flex-1 flex-col",
            !fullWidth && "page-shell",
          ]}
        >
          <slot>
            <h1
              class="text-3xl leading-(--leading-title) font-(--font-weight-title) tracking-(--tracking-title)"
            >
              {title}
            </h1>
          </slot>
        </main>
      </div>
      <SiteFooter />
    </div>
    <script>
      function setPageEntry(
        root: HTMLElement,
        navigationType: string,
        sourceElement?: Element,
      ) {
        root.dataset.pageEntry =
          navigationType === "traverse" ? "history" : "visit";

        const direction =
          navigationType === "traverse"
            ? null
            : sourceElement?.getAttribute("data-work-direction");

        if (direction === "left" || direction === "right") {
          root.dataset.workDirection = direction;
        } else {
          delete root.dataset.workDirection;
        }
      }

      document.addEventListener("astro:before-preparation", (event) => {
        setPageEntry(
          document.documentElement,
          event.navigationType,
          event.sourceElement,
        );
      });

      document.addEventListener("astro:before-swap", (event) => {
        setPageEntry(
          event.newDocument.documentElement,
          event.navigationType,
          event.sourceElement,
        );
      });
    </script>
  </body>
</html>
