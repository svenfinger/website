---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import WorkCard from "@/components/work-card.astro";
import { projects as projectEntries } from "../lib/projects";

function projectCover(slug) {
  const src = `/images/projects/${slug}-cover.jpg`;
  const file = path.join(process.cwd(), "public", src);

  return fs.existsSync(file) ? src : undefined;
}

const projects = projectEntries.map((project) => ({
  ...project,
  image: projectCover(project.slug),
}));
---

<Layout
  title="Projects"
  description="Selected personal projects by Sven Finger."
>
  <h1 class="sr-only">Projects</h1>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      projects.map((project) => (
        <WorkCard
          href={project.href}
          title={project.title}
          description={project.description}
          image={project.image}
          external
        />
      ))
    }
  </div>
</Layout>
