---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Imprint"
  description="Legal imprint for svenfinger.com pursuant to § 5 DDG and § 18(1) MStV."
  noindex
>
  <article
    class="grid grid-cols-1 gap-(--space-4) py-(--space-8) md:grid-cols-3 md:gap-(--space-8) md:py-(--space-16)"
  >
    <h1
      class="text-3xl leading-(--leading-title) font-(--font-weight-title) tracking-(--tracking-title)"
    >
      Imprint
    </h1>
    <div
      class="flex flex-col gap-(--space-6) pt-(--space-3) text-base leading-normal font-(--font-weight-text) md:col-span-2"
    >
      <p>Information pursuant to § 5 DDG and § 18(1) MStV:</p>
      <address class="flex flex-col gap-(--space-6) not-italic">
        <span>
          Sven Finger<br />
          Spitzbergenweg 20b<br />
          22145 Hamburg<br />
          Germany
        </span>
        <a
          href="mailto:hi@svenfinger.com"
          class="w-fit underline underline-offset-2 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
          >hi@svenfinger.com</a
        >
      </address>
    </div>
  </article>
</Layout>
