---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WorkMedia from "@/components/work-media.astro";
import {
  getWorkCover,
  getWorkGallery,
  workMediaAlt,
} from "../../lib/work-media";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return work.map((entry, index) => {
    const prev = work[(index - 1 + work.length) % work.length];
    const next = work[(index + 1) % work.length];

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prevHref: `/work/${prev.id}`,
        nextHref: `/work/${next.id}`,
      },
    };
  });
}

const { entry, prevHref, nextHref } = Astro.props;
const { title, description } = entry.data;
const cover = getWorkCover(entry.id);
const gallery = getWorkGallery(entry.id);
---

<Layout
  title={title}
  description={description}
  workNav={{ title, prevHref, nextHref }}
>
  <div class="flex flex-col gap-(--space-6) py-(--space-8) md:py-(--space-16)">
    <div class="flex max-w-(--layout-prose) flex-col gap-(--space-2)">
      <h1
        class="text-3xl leading-(--leading-title) font-(--font-weight-title) tracking-(--tracking-title)"
      >
        {title}
      </h1>
      <p
        class="text-base leading-normal font-(--font-weight-text) text-muted-foreground"
      >
        {description}
      </p>
    </div>
    <WorkMedia
      src={cover.src}
      type={cover.type}
      alt={workMediaAlt(title, cover.src, "cover")}
      width={cover.width}
      height={cover.height}
      loading="eager"
    />
    {
      gallery.length > 0 && (
        <div class="grid gap-(--space-4) sm:grid-cols-2">
          {gallery.map((item) => (
            <WorkMedia
              src={item.src}
              type={item.type}
              alt={workMediaAlt(title, item.src, "gallery")}
              width={item.width}
              height={item.height}
            />
          ))}
        </div>
      )
    }
  </div>
</Layout>
