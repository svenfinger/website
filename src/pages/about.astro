---
import { createElement } from "react";
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/button";
import { ArrowUpRightIcon } from "lucide-react";

const linkedInLink = createElement("a", {
  href: "https://www.linkedin.com/in/svenfinger/",
  target: "_blank",
  rel: "noreferrer",
});
---

<Layout
  title="About"
  description="Building scalable, user-centered software across design and engineering."
>
  <article
    class="grid grid-cols-1 gap-(--space-4) py-(--space-8) md:grid-cols-3 md:gap-(--space-8) md:py-(--space-16)"
  >
    <h1
      class="text-3xl leading-(--leading-title) font-(--font-weight-title) tracking-(--tracking-title)"
    >
      About
    </h1>
    <div class="flex flex-col gap-(--space-8) pt-(--space-3) md:col-span-2">
      <div
        class="flex max-w-(--layout-prose) flex-col gap-(--space-6) text-base leading-normal font-(--font-weight-text)"
      >
        <p>
          Building scalable, user-centered software across design and
          engineering.
        </p>
        <p>
          I started in web development, moved into design along the way, and
          eventually found myself doing both. Today I help ideas move from early
          direction to production.
        </p>
      </div>
      <div class="flex flex-col gap-(--space-6)">
        <div class="flex flex-col gap-(--space-1)">
          <h2
            class="text-2xl leading-(--leading-subtitle) font-(--font-weight-subtitle) tracking-(--tracking-subtitle)"
          >
            Experience
          </h2>
          <p
            class="text-base leading-normal font-(--font-weight-text) text-muted-foreground"
          >
            15+ years designing and developing · SaaS and agencies
          </p>
        </div>
        <div
          class="flex max-w-(--layout-prose) flex-col gap-(--space-6) text-base leading-normal font-(--font-weight-text)"
        >
          <p>
            I’m a Full-Stack Design Engineer working across strategy, product
            design, design systems, and implementation. I started in web
            development, moved deeper into design, and now enjoy working in the
            space where product thinking and production code meet.
          </p>
          <p>
            I’m especially interested in reusable systems, thoughtful
            interaction details, developer experience, and software that feels
            clear, fast, and useful.
          </p>
        </div>
      </div>
      <Button
        variant="blue"
        nativeButton={false}
        render={linkedInLink}
        className="w-fit gap-(--space-1)"
      >
        LinkedIn
        <ArrowUpRightIcon className="size-4" aria-hidden="true" />
      </Button>
    </div>
  </article>
</Layout>
