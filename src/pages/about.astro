---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRightIcon, ImageIcon } from "lucide-react";
import { getResponsiveImage } from "../lib/images";

// Photograph #008 from Sven's OpenSkies collection. Other media awaits selection.
const sky = await getResponsiveImage(
  "/images/about/openskies-008.jpg",
  [640, 960, 1600],
  "(min-width: 84rem) 827px, (min-width: 48rem) 64vw, calc(100vw - 40px)",
);
---

<Layout
  title="About"
  description="Sven Finger, Full-Stack Design Engineer in Hamburg. A little about my work, what matters to me, and life beyond it."
  noindex
>
  <article class="about">
    <header class="profile editorial-width">
      <div class="profile-copy">
        <p class="label">About</p>
        <h1>Hi, I’m Sven.</h1>
        <p class="introduction">
          A Full-Stack Design Engineer<br class="desktop-break" /> based in Hamburg.
        </p>
        <p class="body biography">
          I started in web development and moved into design. I’ve spent 15+
          years designing and developing software across SaaS companies and
          agencies.
        </p>
        <a class="personal-jump" href="#outside-work">
          There’s also music, my pet, and a collection of skies.
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <figure class="portrait">
        <div class="placeholder portrait-frame">
          <ImageIcon size={24} strokeWidth={1.25} aria-hidden="true" />
          <span class="caption">Portrait to come</span>
        </div>
        <figcaption class="caption">Sven Finger · Hamburg</figcaption>
      </figure>
    </header>

    <div class="professional editorial-width">
      <section aria-labelledby="contribution-title">
        <h2 id="contribution-title">What I bring</h2>
        <div class="body">
          <p>
            Understanding a product, its design, and its implementation together
            helps me see where a decision in one part changes the rest.
          </p>
          <p>
            I bring that perspective into the team’s decisions, then stay
            hands-on as they become interfaces, shared components, and working
            software. The point is to help us decide what to build and carry the
            intent through to the details.
          </p>
        </div>
        <p class="work-note">
          At Flip, that meant proposing livestreams as posts, using a familiar
          part of the product as the starting point.
          <a class="text-link" href="/work/flip-livestream">
            A short example <ArrowUpRightIcon size={14} aria-hidden="true" />
          </a>
        </p>
      </section>
      <section aria-labelledby="approach-title">
        <h2 id="approach-title">How I work</h2>
        <div class="body">
          <p>
            Simple, solid solutions are a better foundation. I look for what we
            can remove, where complexity is necessary, and what will make the
            next change easier.
          </p>
          <p>
            Systems are central to that. Shared components and patterns should
            help people build consistently without having to solve the same
            problem again.
          </p>
          <p>
            I want the reasoning to be understandable, too: what we’re choosing,
            what we’re trading off, and why. That gives a team something
            concrete to discuss and improve.
          </p>
        </div>
      </section>
    </div>

    <section
      class="personal"
      id="outside-work"
      aria-labelledby="personal-title"
    >
      <div class="personal-heading editorial-width">
        <h2 id="personal-title">A little more about me</h2>
        <p class="body">
          Outside work, there’s music, my pet, and World of Warcraft. I also
          make things of my own, including OpenSkies.
        </p>
      </div>

      <div class="personal-collection">
        <figure class="pet">
          <div class="placeholder pet-frame">
            <ImageIcon size={28} strokeWidth={1.25} aria-hidden="true" />
            <span class="caption">Pet photograph to come</span>
          </div>
          <figcaption>
            <span class="caption collection-number" aria-hidden="true">01</span>
            <h3>My pet</h3>
          </figcaption>
        </figure>

        <div class="collection-right">
          <figure class="skies">
            <a
              class="sky-image"
              href="https://openskies.photos/"
              aria-label="Explore OpenSkies, my sky photography side project"
            >
              <img
                src={sky?.src ?? "/images/about/openskies-008.jpg"}
                srcset={sky?.srcSet.attribute}
                sizes={sky?.attributes.sizes}
                width="1920"
                height="1440"
                loading="lazy"
                decoding="async"
                alt="Pink streaks of cloud across a blue evening sky, from the OpenSkies collection."
              />
            </a>
            <figcaption>
              <span class="caption collection-number" aria-hidden="true"
                >02</span
              >
              <div>
                <h3>
                  <a class="text-link" href="https://openskies.photos/">
                    OpenSkies <ArrowUpRightIcon size={16} aria-hidden="true" />
                  </a>
                </h3>
                <p class="caption">
                  A collection of sky photos, free to download and use.
                </p>
              </div>
              <span class="caption photo-number">Photograph 008</span>
            </figcaption>
          </figure>

          <figure class="music">
            <div class="placeholder music-frame">
              <ImageIcon size={24} strokeWidth={1.25} aria-hidden="true" />
              <span class="caption">Photo to come</span>
            </div>
            <figcaption>
              <span class="caption collection-number" aria-hidden="true"
                >03</span
              >
              <h3>Music</h3>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <footer class="contact editorial-width">
      <p class="caption">Sven Finger · Hamburg</p>
      <nav aria-label="Contact Sven">
        <a class="text-link" href="mailto:hi@svenfinger.com">
          Email <ArrowUpRightIcon size={16} aria-hidden="true" />
        </a>
        <a class="text-link" href="https://www.linkedin.com/in/svenfinger/">
          LinkedIn <ArrowUpRightIcon size={16} aria-hidden="true" />
        </a>
      </nav>
    </footer>
  </article>
</Layout>

<style>
  .about {
    padding-block: var(--space-16) var(--space-24);
    overflow-wrap: anywhere;
  }

  .editorial-width {
    width: 100%;
    max-width: calc(var(--layout-content) + var(--space-32));
    margin-inline: auto;
  }

  h1,
  h2,
  h3,
  p,
  figure {
    margin: 0;
  }

  h1 {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
  }

  h2 {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-subtitle);
    line-height: var(--leading-subtitle);
    letter-spacing: var(--tracking-subtitle);
    text-wrap: balance;
  }

  h3 {
    font-size: var(--text-base);
    font-weight: var(--font-weight-label);
    line-height: var(--leading-normal);
  }

  .body {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-text);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .body p + p {
    margin-top: var(--space-4);
  }

  .label,
  .caption {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .label {
    margin-bottom: var(--space-4);
    font-weight: var(--font-weight-label);
  }

  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: center;
    gap: var(--space-16);
  }

  .introduction {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
    line-height: 1.4;
    font-weight: var(--font-weight-text);
  }

  .biography {
    max-width: 50ch;
    margin-top: var(--space-6);
    color: var(--color-muted-foreground);
  }

  .personal-jump {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.3em;
  }

  .personal-jump span {
    flex-shrink: 0;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted-foreground);
    text-align: center;
  }

  .portrait-frame {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
  }

  .portrait figcaption {
    margin-top: var(--space-3);
  }

  .professional {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .professional h2 {
    margin-bottom: var(--space-6);
  }

  .work-note {
    margin-top: var(--space-6);
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .work-note a {
    display: flex;
    width: fit-content;
    margin-top: var(--space-2);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
  }

  .text-link :global(svg) {
    flex-shrink: 0;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 5px;
    border-radius: var(--radius-sm);
  }

  .personal {
    margin-top: var(--space-24);
    scroll-margin-top: var(--space-24);
  }

  .personal-heading {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    align-items: start;
    margin-bottom: var(--space-8);
  }

  .personal-heading .body {
    color: var(--color-muted-foreground);
  }

  .personal-collection {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-6);
  }

  .pet-frame {
    aspect-ratio: 3 / 4;
  }

  .personal-collection figcaption {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .collection-number {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .sky-image {
    display: block;
  }

  .sky-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: center 65%;
  }

  .skies figcaption .caption {
    margin-top: var(--space-1);
  }

  .photo-number {
    margin-left: auto;
    text-align: right;
  }

  .music {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .music-frame {
    width: 8rem;
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  .music figcaption {
    margin-top: 0;
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .contact nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-size: var(--text-sm);
  }

  @media (max-width: 63.999rem) {
    .profile,
    .professional,
    .personal-heading {
      gap: var(--space-8);
    }

    .profile {
      grid-template-columns: minmax(0, 1fr) 12rem;
    }

    .photo-number {
      display: none;
    }
  }

  @media (max-width: 47.999rem) {
    .about {
      padding-block: var(--space-8) var(--space-16);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    .profile {
      grid-template-columns: minmax(0, 1fr) 6rem;
      gap: var(--space-6);
      align-items: start;
    }

    .profile-copy {
      display: contents;
    }

    .profile .label {
      grid-column: 1;
      margin-bottom: 0;
    }

    .profile h1 {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
    }

    .portrait {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .portrait-frame {
      padding: var(--space-2);
      gap: var(--space-2);
    }

    .portrait .caption {
      font-size: var(--text-xs);
    }

    .portrait figcaption {
      display: none;
    }

    .introduction,
    .biography,
    .personal-jump {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .introduction {
      font-size: var(--text-xl);
    }

    .desktop-break {
      display: none;
    }

    .professional,
    .personal-heading,
    .personal-collection {
      grid-template-columns: minmax(0, 1fr);
    }

    .professional {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      gap: var(--space-12);
    }

    .professional h2 {
      margin-bottom: var(--space-4);
    }

    .personal {
      margin-top: var(--space-16);
    }

    .personal-heading {
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .personal-collection {
      gap: var(--space-8);
    }

    .pet-frame {
      aspect-ratio: 4 / 5;
    }

    .sky-image img {
      aspect-ratio: 4 / 3;
    }

    .music-frame {
      width: 40%;
      max-width: 10rem;
    }

    .contact {
      align-items: flex-start;
      flex-direction: column;
      margin-top: var(--space-12);
    }
  }
</style>
