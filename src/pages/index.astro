---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import WorkCard from "@/components/work-card.astro";
import { getWorkCover } from "../lib/work-media";

const work = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Work"
  description="Selected product design and engineering work by Sven Finger."
>
  <h1 class="sr-only">Work</h1>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      work.map((entry) => (
        <WorkCard
          href={`/work/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          image={getWorkCover(entry.id).src}
        />
      ))
    }
  </div>
</Layout>
