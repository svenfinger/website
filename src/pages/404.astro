---
import Layout from "../layouts/Layout.astro";
import { buttonClass } from "@/components/button";
---

<Layout title="Not found" description="This page does not exist." noindex>
  <div class="legal-page">
    <h1 class="type-display">Page not found</h1>
    <p class="text-muted-foreground">
      That URL doesn’t exist. Head back home to see my latest work.
    </p>
    <a class={buttonClass({ className: "self-start" })} href="/"> Back home </a>
  </div>
</Layout>
