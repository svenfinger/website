{
  "openapi": "3.1.1",
  "info": {
    "title": "Sven Finger portfolio",
    "version": "1.0.0",
    "description": "Read-only public portfolio pages. Send Accept: text/markdown for Markdown or Accept: text/html for HTML at the same URL. Quality values and wildcards are supported; HTML wins otherwise equal preferences. There is no JSON portfolio API and no write API. Unknown URLs return 404, optionally as JSON problem details."
  },
  "servers": [
    {
      "url": "https://svenfinger.com"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getPortfolio",
        "summary": "Read Portfolio",
        "responses": {
          "200": {
            "description": "Portfolio",
            "headers": {
              "Vary": {
                "schema": {
                  "type": "string"
                },
                "example": "Accept"
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "example": "<!doctype html><html lang=\"en\">\u2026</html>"
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                },
                "example": "# Portfolio\n"
              }
            }
          },
          "304": {
            "description": "Selected representation has not changed."
          },
          "406": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "head": {
        "operationId": "headPortfolio",
        "summary": "Read representation headers without a response body",
        "responses": {
          "200": {
            "description": "Portfolio",
            "headers": {
              "Vary": {
                "schema": {
                  "type": "string"
                },
                "example": "Accept"
              }
            }
          },
          "304": {
            "description": "Selected representation has not changed."
          },
          "406": {
            "description": "Error status; no response body."
          },
          "500": {
            "description": "Error status; no response body."
          }
        }
      }
    },
