---
import { ArrowUpRightIcon } from "lucide-react";
import { getResponsiveImage } from "@/src/lib/images";

const {
  href,
  title,
  description,
  image,
  external = false,
  index = 0,
} = Astro.props;
const responsiveImage = image
  ? await getResponsiveImage(
      image,
      [480, 768, 1280, 1536],
      "(min-width: 84rem) 624px, (min-width: 48rem) calc((100vw - 96px) / 2), calc(100vw - 40px)",
    )
  : undefined;
---

<a
  href={href}
  class="flex origin-center flex-col gap-(--space-4) overflow-hidden rounded-lg bg-(--color-surface) brightness-100 outline-none transition-[scale,filter] duration-(--duration-default) ease-(--ease-standard) hover:scale-[1.01] hover:brightness-[1.1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground active:scale-[0.99] active:brightness-[0.94] active:duration-(--duration-fast) motion-reduce:transform-none motion-reduce:brightness-100 motion-reduce:hover:brightness-100 motion-reduce:active:brightness-100"
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  {
    image ? (
      <img
        width={responsiveImage?.attributes.width}
        height={responsiveImage?.attributes.height}
        sizes={responsiveImage?.attributes.sizes}
        src={responsiveImage?.src ?? image}
        srcset={responsiveImage?.srcSet.attribute}
        alt=""
        loading={index < 2 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : undefined}
        decoding="async"
        class="aspect-530/298 w-full object-cover"
      />
    ) : (
      <div class="aspect-530/298 w-full bg-background" aria-hidden="true" />
    )
  }
  <div
    class="flex flex-col gap-(--space-1) px-(--space-4) pb-(--space-4) text-base leading-normal font-(--font-weight-text)"
  >
    <p class="flex items-start justify-between gap-(--space-2) text-foreground">
      <span>{title}</span>
      {
        external && (
          <ArrowUpRightIcon
            className="mt-(--space-1) size-4 shrink-0 text-muted-foreground"
            aria-hidden="true"
          />
        )
      }
    </p>
    <p class="text-muted-foreground">{description}</p>
  </div>
</a>
