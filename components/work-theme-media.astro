---
import type { ComponentProps } from "react";
import { WorkThemeMedia } from "./work-theme-media";
import { getResponsiveImage } from "@/src/lib/images";

type Props = ComponentProps<typeof WorkThemeMedia>;

const { light, dark } = Astro.props;
const sizes =
  "(min-width: 100rem) 1536px, (min-width: 48rem) calc(100vw - 64px), calc(100vw - 40px)";
const [responsiveLight, responsiveDark] = await Promise.all(
  [light, dark].map(async (image) => {
    const responsive = await getResponsiveImage(
      image.src,
      [480, 768, 1280, 1920, 2560, 3072],
      sizes,
    );
    return {
      ...image,
      src: responsive?.src ?? image.src,
      srcSet: responsive?.srcSet.attribute,
      sizes,
    };
  }),
);
---

<WorkThemeMedia
  client:visible={{ rootMargin: "600px" }}
  light={responsiveLight}
  dark={responsiveDark}
/>
