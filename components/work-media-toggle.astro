---
import type { ComponentProps } from "react";
import { WorkMediaToggle } from "./work-media-toggle";
import { getResponsiveImage } from "@/src/lib/images";

type Props = ComponentProps<typeof WorkMediaToggle>;

const { label, toggleLabel, options } = Astro.props;
const sizes =
  "(min-width: 100rem) 1536px, (min-width: 48rem) calc(100vw - 64px), calc(100vw - 40px)";
const responsiveOptions = await Promise.all(
  options.map(async (image) => {
    const responsive = await getResponsiveImage(
      image.src,
      [480, 768, 1280, 1920, 2560, 3072],
      sizes,
    );
    return {
      ...image,
      src: responsive?.src ?? image.src,
      srcSet: responsive?.srcSet.attribute,
      sizes,
    };
  }),
);
---

<WorkMediaToggle
  client:visible={{ rootMargin: "600px" }}
  label={label}
  toggleLabel={toggleLabel}
  options={responsiveOptions}
/>
