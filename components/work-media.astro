---
import { getResponsiveImage } from "@/src/lib/images";
import type { WorkVideoSources } from "@/src/lib/work-video";

interface Props {
  src: string;
  type?: "image" | "video";
  poster?: string;
  videoSources?: WorkVideoSources;
  alt: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  aspectRatio?: "16 / 9" | "3 / 2" | "1 / 1" | "2 / 3";
}

const {
  src,
  type = "image",
  poster,
  videoSources,
  alt,
  width,
  height,
  loading = "lazy",
  aspectRatio,
} = Astro.props;
const sizes = "(min-width: 44.5rem) 672px, calc(100vw - 40px)";
const responsiveImage =
  type === "image"
    ? await getResponsiveImage(src, [480, 672, 1024, 1344, 2016], sizes)
    : undefined;
const responsivePoster = poster
  ? await getResponsiveImage(poster, [672, 1344], sizes)
  : undefined;
const posterSrc = responsivePoster?.src ?? poster;
---

<div
  class:list={["work-media", aspectRatio && "work-media--framed"]}
  style={aspectRatio && `aspect-ratio: ${aspectRatio}`}
>
  {
    type === "video" ? (
      <>
        <video
          data-work-video
          loop
          muted
          playsinline
          preload="none"
          data-src={src}
          data-src-medium={videoSources?.medium}
          data-src-large={videoSources?.large}
          data-poster={posterSrc}
          poster={loading === "eager" ? posterSrc : undefined}
          width={width}
          height={height}
          aria-label={alt}
        />
        <noscript>
          <img
            src={posterSrc}
            width={width}
            height={height}
            alt={alt}
            loading={loading}
          />
        </noscript>
      </>
    ) : (
      <img
        src={responsiveImage?.src ?? src}
        srcset={responsiveImage?.srcSet.attribute}
        sizes={responsiveImage?.attributes.sizes}
        width={responsiveImage?.attributes.width ?? width}
        height={responsiveImage?.attributes.height ?? height}
        alt={alt}
        loading={loading}
        decoding="async"
      />
    )
  }
</div>

<script>
  import { getWorkVideoSource } from "@/src/lib/work-video";

  function initWorkMedia() {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const videos = document.querySelectorAll<HTMLVideoElement>(
      "video[data-work-video]",
    );
    if (!videos.length) return;
    const visibleVideos = new Set<HTMLVideoElement>();
    const load = (video: HTMLVideoElement) => {
      if (video.dataset.poster) video.poster = video.dataset.poster;
      if (reduceMotion && video.poster) return;
      const src = getWorkVideoSource(video);
      if (!video.getAttribute("src") && src) {
        video.src = src;
        video.preload = "metadata";
      }
    };
    const play = (video: HTMLVideoElement) => {
      if (reduceMotion || document.hidden) return;
      load(video);
      void video.play().catch(() => {
        // Keep the poster visible if the browser blocks autoplay.
      });
    };
    const loadObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          load(entry.target as HTMLVideoElement);
          loadObserver.unobserve(entry.target);
        }
      },
      { rootMargin: "300px 0px" },
    );
    const playObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          visibleVideos.add(video);
          play(video);
        } else {
          visibleVideos.delete(video);
          video.pause();
        }
      }
    });
    const updatePlayback = () => {
      for (const video of visibleVideos) {
        if (document.hidden) video.pause();
        else play(video);
      }
    };

    for (const video of videos) {
      loadObserver.observe(video);
      playObserver.observe(video);
    }
    document.addEventListener("visibilitychange", updatePlayback);
  }

  initWorkMedia();
</script>

<style>
  .work-media {
    position: relative;
    overflow: clip;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .work-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-border);
    border-radius: inherit;
    pointer-events: none;
  }

  .work-media > :is(img, video) {
    display: block;
    width: 100%;
    height: auto;
  }

  .work-media--framed > :is(img, video) {
    height: 100%;
    object-fit: cover;
  }

  noscript img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
