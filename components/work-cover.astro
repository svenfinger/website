---
import { getResponsiveImage } from "@/src/lib/images";
import type { WorkVideoSources } from "@/src/lib/work-video";

interface Props {
  title: string;
  category: string;
  src: string;
  type?: "image" | "video";
  poster?: string;
  videoSources?: WorkVideoSources;
}

const {
  title,
  category,
  src,
  type = "image",
  poster,
  videoSources,
} = Astro.props;
const responsiveImage =
  type === "image"
    ? await getResponsiveImage(src, [768, 1280, 1920, 2560, 3200], "100vw")
    : undefined;
const responsivePoster = poster
  ? await getResponsiveImage(poster, [1280], "100vw")
  : undefined;
---

<header class="work-cover">
  {
    type === "video" ? (
      <video
        src={videoSources ? undefined : src}
        data-src={src}
        data-src-medium={videoSources?.medium}
        data-src-large={videoSources?.large}
        poster={responsivePoster?.src ?? poster}
        width="3200"
        height="1800"
        loop
        muted
        playsinline
        preload={videoSources ? "none" : "auto"}
        aria-hidden="true"
      />
    ) : (
      <img
        sizes={responsiveImage?.attributes.sizes}
        src={responsiveImage?.src ?? src}
        srcset={responsiveImage?.srcSet.attribute}
        alt=""
        width={responsiveImage?.attributes.width ?? 3200}
        height={responsiveImage?.attributes.height ?? 1800}
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="work-cover-shade" aria-hidden="true"></div>
  <div class="page-shell work-cover-content">
    <p>{category}</p>
    <h1>{title}</h1>
  </div>
</header>

<script>
  import { getWorkVideoSource } from "@/src/lib/work-video";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const video of document.querySelectorAll(".work-cover > video")) {
      if (video instanceof HTMLVideoElement) {
        const src = getWorkVideoSource(video);
        if (!video.getAttribute("src") && src) video.src = src;
        video.preload = "auto";
        video.autoplay = true;
        void video.play().catch(() => {
          // Keep the poster visible if the browser blocks autoplay.
        });
      }
    }
  }
</script>
