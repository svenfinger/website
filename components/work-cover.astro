---
interface Props {
  title: string;
  category: string;
  src: string;
  type?: "image" | "video";
  poster?: string;
}

const { title, category, src, type = "image", poster } = Astro.props;
---

<header class="work-cover">
  {
    type === "video" ? (
      <video
        src={src}
        poster={poster}
        width="3200"
        height="1800"
        loop
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      />
    ) : (
      <img
        src={src}
        alt=""
        width="3200"
        height="1800"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="work-cover-shade" aria-hidden="true"></div>
  <div class="page-shell work-cover-content">
    <p>{category}</p>
    <h1>{title}</h1>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    for (const video of document.querySelectorAll(".work-cover > video")) {
      if (video instanceof HTMLVideoElement) {
        video.autoplay = true;
        void video.play().catch(() => {
          // Keep the poster visible if the browser blocks autoplay.
        });
      }
    }
  });
</script>
