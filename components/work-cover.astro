---
import { getResponsiveImage } from "@/src/lib/images";

interface Props {
  title: string;
  category: string;
  src: string;
  type?: "image" | "video";
  poster?: string;
}

const { title, category, src, type = "image", poster } = Astro.props;
const responsiveImage =
  type === "image"
    ? await getResponsiveImage(src, [768, 1280, 1920, 2560, 3200], "100vw")
    : undefined;
const responsivePoster = poster
  ? await getResponsiveImage(poster, [1280], "100vw")
  : undefined;
---

<header class="work-cover">
  {
    type === "video" ? (
      <video
        src={src}
        poster={responsivePoster?.src ?? poster}
        width="3200"
        height="1800"
        loop
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      />
    ) : (
      <img
        sizes={responsiveImage?.attributes.sizes}
        src={responsiveImage?.src ?? src}
        srcset={responsiveImage?.srcSet.attribute}
        alt=""
        width={responsiveImage?.attributes.width ?? 3200}
        height={responsiveImage?.attributes.height ?? 1800}
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="work-cover-shade" aria-hidden="true"></div>
  <div class="page-shell work-cover-content">
    <p>{category}</p>
    <h1>{title}</h1>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    for (const video of document.querySelectorAll(".work-cover > video")) {
      if (video instanceof HTMLVideoElement) {
        video.autoplay = true;
        void video.play().catch(() => {
          // Keep the poster visible if the browser blocks autoplay.
        });
      }
    }
  });
</script>
