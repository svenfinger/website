---
import { SITE_NAME } from "@/src/lib/site";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const Name = home ? "h1" : "a";
---

<header class="flex items-center gap-(--space-4)">
  <img src="/images/site/logo.svg" width="32" height="32" alt="" />
  <span aria-hidden="true" class="h-6 w-px rounded-full bg-border"></span>
  <Name
    id={home ? "intro-title" : undefined}
    href={home ? undefined : "/"}
    class="type-heading rounded-sm"
  >
    {SITE_NAME}
  </Name>
</header>
