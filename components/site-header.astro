---
import { SITE_NAME } from "@/src/lib/site";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const Name = home ? "h1" : "div";
---

<header class="flex items-center gap-(--space-4)">
  <Name id={home ? "intro-title" : undefined}>
    <a href="/" class="inline-flex rounded-sm">
      <img
        src="/images/site/logo.svg"
        width="32"
        height="32"
        alt={`${SITE_NAME} home`}
      />
    </a>
  </Name>
</header>
