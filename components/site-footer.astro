---
import { ArrowUpRightIcon } from "lucide-react";

import { SITE_NAME } from "@/src/lib/site";

const year = new Date().getFullYear();
const statsHref =
  "https://plausible.io/svenfinger.com?period=28d&keybindHint=F";
---

<footer class="mt-auto">
  <div
    class="flex flex-col gap-4 px-6 py-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-sm text-muted-foreground">© {year} {SITE_NAME}</p>
    <nav aria-label="Footer" class="flex items-center gap-4 text-sm">
      <a href="/privacy" class="text-muted-foreground hover:text-foreground">
        Privacy
      </a>
      <a href="/imprint" class="text-muted-foreground hover:text-foreground">
        Imprint
      </a>
      <a
        href={statsHref}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
      >
        Stats
        <ArrowUpRightIcon className="size-3.5" />
      </a>
    </nav>
  </div>
</footer>
