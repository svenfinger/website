---
import { ArrowUpRightIcon, CopyrightIcon } from "lucide-react";

import { SITE_NAME } from "@/src/lib/site";

const year = new Date().getFullYear();
const statsHref =
  "https://plausible.io/svenfinger.com?period=28d&keybindHint=F";
---

<footer class="mt-auto border-t border-(--color-border-subtle)">
  <div class="page-shell">
    <div
      class="flex flex-col items-center gap-(--space-4) py-(--space-8) md:h-(--space-16) md:flex-row md:justify-between md:py-0"
    >
      <p
        class="flex items-center gap-(--space-2) text-sm leading-(--leading-label) font-(--font-weight-label)"
      >
        <CopyrightIcon className="size-3" aria-hidden="true" />
        {`${year} ${SITE_NAME}`}
      </p>
      <nav aria-label="Footer" class="flex items-center gap-(--space-1)">
        <a href={statsHref} target="_blank" rel="noreferrer" class="nav-pill">
          Stats
          <ArrowUpRightIcon className="size-4" aria-hidden="true" />
        </a>
        <a href="/privacy" class="nav-pill">Privacy</a>
        <a href="/imprint" class="nav-pill">Imprint</a>
      </nav>
    </div>
  </div>
</footer>
