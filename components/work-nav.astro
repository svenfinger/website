---
import { ChevronLeftIcon, ChevronRightIcon } from "lucide-react";

import { buttonClass } from "@/components/button";

const { title, prevHref, nextHref } = Astro.props;
---

<nav
  class="sticky top-0 z-50 bg-background"
  aria-label="Work navigation"
  data-work-nav
>
  <div
    class="page-shell flex h-(--space-16) items-center justify-between gap-(--space-4)"
  >
    <p
      class="min-w-0 flex-1 truncate text-sm leading-(--leading-label) font-(--font-weight-label)"
    >
      {title}
    </p>
    <div class="flex shrink-0 items-center gap-(--space-1)">
      <a
        class={buttonClass({ size: "icon" })}
        href={prevHref}
        aria-label="Previous work"
      >
        <ChevronLeftIcon className="size-4" />
      </a>
      <a
        class={buttonClass({ size: "icon" })}
        href={nextHref}
        aria-label="Next work"
      >
        <ChevronRightIcon className="size-4" />
      </a>
    </div>
  </div>
</nav>

<style>
  nav::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    border-bottom: 1px solid var(--color-border-subtle);
    opacity: 0;
    pointer-events: none;
  }

  nav[data-cover-passed]::after {
    opacity: 1;
  }
</style>

<script>
  function initWorkNav() {
    const nav = document.querySelector<HTMLElement>("[data-work-nav]");
    if (!nav) return;

    const cover = document.querySelector<HTMLElement>(".work-cover");
    if (!cover) {
      nav.setAttribute("data-cover-passed", "");
      return;
    }

    const updateBorder = () => {
      nav.toggleAttribute(
        "data-cover-passed",
        cover.getBoundingClientRect().bottom <=
          nav.getBoundingClientRect().bottom,
      );
    };

    updateBorder();
    const coverObserver = new IntersectionObserver(
      ([entry]) => {
        nav.toggleAttribute(
          "data-cover-passed",
          !entry.isIntersecting &&
            entry.boundingClientRect.bottom <=
              nav.getBoundingClientRect().bottom,
        );
      },
      { rootMargin: `-${nav.offsetHeight}px 0px 0px 0px` },
    );
    coverObserver.observe(cover);
  }

  initWorkNav();
</script>
